# Copy this file to .env.local (and to your Vercel project's Environment
# Variables) and fill in real values. Never commit .env.local.

# ── Sanity CMS ──────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
#SANITY_API_TOKEN=

# ── Gmail SMTP (inquiry notification email) ──────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL_TO=enquiry@queuecap.com

# ── WhatsApp via CallMeBot (optional) ────────────────────
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ── Google Sheets (inquiry log — see google-apps-script/Code.gs) ──
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://queuecap.com
